{
  "name": "truco-mineiro",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --filter @truco/web --filter @truco/server dev",
    "build": "bun run --filter @truco/web build",
    "start": "bun apps/server/src/index.ts",
    "check": "bun run --filter @truco/web --filter @truco/server --filter @truco/protocol check",
    "test": "bun test",
    "preview": "bun run --filter @truco/web preview",
    "docker:build": "docker build --tag trucossoca .",
    "docker:load": "gunzip -c trucossoca.tar.gz | docker load",
    "docker:start": "docker run --name trucossoca -d --restart unless-stopped -p 127.0.0.1:3002:3000 trucossoca",
    "docker:stop": "docker stop trucossoca && docker rm trucossoca"
  },
  "devDependencies": {
    "bun-types": "^1.4.2"
  }
}
